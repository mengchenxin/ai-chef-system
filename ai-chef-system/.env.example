# ===== 服务 =====
PORT=3000

# ===== MySQL =====
# 数据库需要提前建好，表结构由 Sequelize 启动时自动同步
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_chef_db
DB_USER=root
DB_PASSWORD=

# 首次启动、或给模型加了新字段之后，临时改成 1 让 Sequelize 同步表结构；
# 同步完成务必改回 0 —— alter 会按模型改写线上表结构，日常启动不该开。
DB_SYNC_ALTER=0

# ===== 大模型（DeepSeek 走 OpenAI 兼容协议） =====
# 变量名沿用 OPENAI_API_KEY，里面填 DeepSeek 的 key
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# ===== Agent =====
# 单轮对话最多允许多少次节点跳转，防止工具调用来回打转把 token 烧光
AGENT_RECURSION_LIMIT=10
